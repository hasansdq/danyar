generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Roles: SUPER_ADMIN | SCHOOL_ADMIN | TEACHER | STUDENT ───

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  // تفکیک نام و نام خانوادگی (فرم‌های افزودن کاربر) — fullName همیشه ترکیب این دو نگه داشته می‌شود
  firstName    String?
  lastName     String?
  role         String
  // شماره تلفن یکتا در کل پلتفرم — قالب نرمال 09xxxxxxxxx؛ برای ورود پیامکی
  phone        String?  @unique
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isActive     Boolean  @default(true)
  // تصویر پروفایل (فایل ذخیره‌شده روی دیسک)
  avatarKey    String?
  avatarMime   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments            ClassroomEnrollment[]
  teachingAssignments    TeachingAssignment[]
  sentMessages           Message[]                @relation("msgSender")
  receivedMessages       Message[]                @relation("msgRecipient")
  pinnedMessages         Message[]                @relation("msgPinnedBy")
  groupMemberOverrides   GroupMemberOverride[]
  groupReadStates        GroupReadState[]
  uploads                Upload[]
  createdAssignments     Assignment[]             @relation("assignmentCreator")
  submissions            AssignmentSubmission[]   @relation("submissionStudent")
  notifications          Notification[]
  notificationPref       NotificationPref?
  mutedChats             MutedChat[]
  pushSubscriptions      PushSubscription[]
  hostedLiveSessions     LiveSession[]            @relation("liveSessionHost")
  endedLiveSessions      LiveSession[]            @relation("liveSessionEnder")
  liveChatMessages       LiveChatMessage[]        @relation("liveChatSender")
  liveParticipantLogs    LiveParticipantLog[]     @relation("liveParticipantLog")
  aiConversations        AiConversation[]
  aiUsageLogs            AiUsageLog[]
  attendanceSessions     AttendanceSession[]      @relation("attendanceSessionCreator")
  attendanceRecords      AttendanceRecord[]       @relation("attendanceStudent")
  attendanceEdits        AttendanceEditLog[]      @relation("attendanceEditor")
  sampleqCreated         SampleQuestion[]         @relation("sampleqCreator")
  impersonationsStarted  ImpersonationLog[]       @relation("impersonationAdmin")
  impersonationsTargeted ImpersonationLog[]       @relation("impersonationTarget")
  bulkSends              BulkSendLog[]            @relation("bulkSendLog")
  sampleqBookmarks       SampleQuestionBookmark[] @relation("sampleqBookmarker")
  classEventsCreated     ClassEvent[]             @relation("classEventCreator")
  // تخلفات ثبت‌شده برای این کاربر (به‌عنوان دانش‌آموز) و توسط این کاربر (ثبت‌کننده)
  violationsAsStudent    StudentViolation[]       @relation("violationStudent")
  violationsAsCreator    StudentViolation[]       @relation("violationCreator")
  // محدودیت‌های دسترسی‌ای که مدیر مدرسه برای این معاون تعیین کرده
  vicePermissionOverrides VicePermission[]        @relation("vicePermissionVice")
  // درس‌های منتسب به این کاربر (معلم) و نمرات داده‌شده/گرفته‌شده
  teacherLessons        TeacherLesson[]           @relation("teacherLessonTeacher")
  gradesGiven           StudentGrade[]            @relation("gradeCreator")
  gradesReceived        StudentGrade[]            @relation("gradeStudent")
}

// فایل آپلودشده که هنوز به پیامی متصل نشده (مرحله میانی)
model Upload {
  key        String   @id
  name       String
  mime       String
  size       Int
  type       String // IMAGE | AUDIO | VIDEO | FILE
  uploaderId String
  // مدرسه مالک رسانه — از مدرسه آپلودکننده در لحظه آپلود ثبت می‌شود؛
  // آپلود مدیر کل (بدون مدرسه) null می‌ماند
  schoolId   String?
  // تعداد دریافت کامل فایل (هر پاسخ ۲۰۰ بدون Range یک شمارش)
  downloadCount Int   @default(0)
  createdAt  DateTime @default(now())

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  school   School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([createdAt])
}

model School {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  // پرچم‌های امکانات هر مدرسه (JSON): chat, dm, assignments, onlineClass, attendance, sampleq
  features  String   @default("{\"chat\":true,\"dm\":true,\"assignments\":true,\"onlineClass\":true,\"attendance\":true,\"sampleq\":true}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  classrooms      Classroom[]
  aiSetting       AiSchoolSetting?
  sampleQuestions SampleQuestion[]
  classEvents     ClassEvent[]
  uploads         Upload[]
  // درس‌های تعریف‌شدهٔ این مدرسه (ریاضی، علوم و…) — باکس «درس‌ها» پنل مدیریت
  lessons         Lesson[]
  // گروه‌های عمومی مدرسه (همکاران/عمومی/پایه) — بدون کلاس مشخص
  publicGroups    SubjectGroup[]
  // سهمیه کل آپلود مدرسه بر حسب گیگابایت — 0 یعنی نامحدود
  mediaQuotaGB    Float    @default(0)
  // سقف افراد هم‌زمان هر جلسه در این مدرسه (معلم نیز جزو ظرفیت) —
  // null = بدون سقف اختصاصی مدرسه (سقف جهانی LIVE_MAX_PARTICIPANTS اعمال می‌شود).
  // سقف نرم‌افزاری ورود است؛ تضمین توان سخت‌افزاری برای این تعداد کاربر نیست.
  // ظرفیت اختصاصی هر کلاس (Classroom.capacity) هرگز نمی‌تواند از آن بیشتر شود.
  liveMaxParticipants Int?
  // حداکثر تعداد جلسات هم‌زمان این مدرسه — null = نامحدود (هر کلاس همچنان فقط یک جلسه)
  liveMaxConcurrent   Int?
}

model Classroom {
  id             String   @id @default(cuid())
  name           String
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // پایه تحصیلی کلاس (از GRADE_OPTIONS) — همه دانش‌آموزان کلاس همین پایه را می‌گیرند؛
  // مبنای گروه‌های پایه‌ای پیام‌رسان (مثلاً «همه پایه هفتمی‌ها»)
  grade          String?
  // گفتگوی خصوصی بین هم‌کلاسی‌ها (پیش‌فرض غیرفعال؛ مدیر مدرسه فعال می‌کند)
  allowStudentDm Boolean  @default(false)
  // ظرفیت کلاس آنلاین این کلاس — null = سقف سراسری LIVE_MAX_PARTICIPANTS
  // (تعیین از پنل مدیر کل؛ حداکثر شرکت‌کنندگان هم‌زمان جلسات همین کلاس)
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subjectGroups      SubjectGroup[]
  enrollments        ClassroomEnrollment[]
  liveSessions       LiveSession[]
  attendanceSessions AttendanceSession[]
  sampleQuestions    SampleQuestionClass[]
  classEvents        ClassEvent[]
  violations         StudentViolation[]
  // نمرات ثبت‌شده برای دانش‌آموزان این کلاس
  grades             StudentGrade[]

  @@unique([schoolId, name])
}

// گروه پیام‌رسانی — دو نوع:
// ۱) گروه درسی کلاس (scope=CLASS، classroomId مشخص، مثلاً «ریاضی هفتم۱»)
// ۲) گروه عمومی مدرسه (scope=SCHOOL_STAFF|SCHOOL_ALL|GRADE، بدون کلاس؛ schoolId مالک است)
model SubjectGroup {
  id              String     @id @default(cuid())
  name            String
  // برای گروه‌های عمومی مدرسه null است
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // مدرسه مالک — فقط برای گروه‌های عمومی (scope != CLASS) ثبت می‌شود
  schoolId        String?
  school          School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // CLASS | SCHOOL_STAFF (همکاران) | SCHOOL_ALL (عمومی) | GRADE (پایه)
  scope           String     @default("CLASS")
  // پایه گروه — فقط برای scope=GRADE (از GRADE_OPTIONS)
  grade           String?
  // بایگانی: فقط‌خواندنی می‌شود و از گفتگوهای فعال حذف می‌شود
  archivedAt      DateTime?
  // قفل برای دانش‌آموزان: گروه مخفی/حذف نمی‌شود و بقیه اعضا عادی پیام می‌فرستند؛
  // فقط دانش‌آموز ارسال پیام/فایل برایش بسته است (مشاهده آزاد است)
  lockedForStudents Boolean @default(false)
  // مجوز ارسال پیام: ALL | STAFF (معلم و مدیر) | ADMINS (فقط مدیر مدرسه)
  messagePolicy   String     @default("ALL")
  // تصویر پروفایل گروه (اختیاری) — از سیستم آپلود سراسری
  avatarKey       String?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teachingAssignments TeachingAssignment[]
  messages            Message[]
  memberOverrides     GroupMemberOverride[]
  readStates          GroupReadState[]
  assignments         Assignment[]
  liveAnnouncements   LiveSession[]         @relation("liveSessionNotify")

  @@unique([classroomId, name])
  @@index([schoolId])
}

// ثبت دانش‌آموز در کلاس → عضویت خودکار در همه گروه‌های درسی آن کلاس
model ClassroomEnrollment {
  id          String   @id @default(cuid())
  studentId   String
  classroomId String
  createdAt   DateTime @default(now())

  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([studentId, classroomId])
}

// انتساب معلم به یک گروه درسی مشخص
model TeachingAssignment {
  id             String   @id @default(cuid())
  teacherId      String
  subjectGroupId String
  createdAt      DateTime @default(now())

  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectGroup SubjectGroup @relation(fields: [subjectGroupId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectGroupId])
}

// استثناهای عضویت گروه: حذف دانش‌آموز ثبت‌نام‌شده یا افزودن دانش‌آموز دیگر
model GroupMemberOverride {
  id             String   @id @default(cuid())
  subjectGroupId String
  userId         String
  action         String // ADD | REMOVE
  createdAt      DateTime @default(now())

  subjectGroup SubjectGroup @relation(fields: [subjectGroupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectGroupId, userId])
}

// آخرین زمان خواندن هر کاربر در هر گروه (برای شمارنده نخوانده)
model GroupReadState {
  id             String   @id @default(cuid())
  userId         String
  subjectGroupId String
  lastReadAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectGroup SubjectGroup @relation(fields: [subjectGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectGroupId])
}

// پیام یکپارچه: گروهی (GROUP) و خصوصی (DIRECT)
model Message {
  id             String        @id @default(cuid())
  kind           String // GROUP | DIRECT
  subjectGroupId String?
  subjectGroup   SubjectGroup? @relation(fields: [subjectGroupId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("msgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String? // فقط DIRECT: طرف مقابل
  recipient      User?         @relation("msgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  type           String  @default("TEXT") // TEXT | IMAGE | AUDIO | VIDEO | FILE | ANNOUNCEMENT
  body           String  @default("")
  // پیوست (تصویر/صوت/ویدئو/فایل)
  attachmentName String?
  attachmentKey  String?
  attachmentMime String?
  attachmentSize Int?
  // فراداده پیوست صوتی (پیام ویس): JSON مثل {"duration":12.4,"waveform":[0.2,...]}
  attachmentMeta String?

  // پاسخ به پیام
  replyToId String?
  replyTo   Message?  @relation("msgReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("msgReply")

  // شناسه یکتای سمت کلاینت برای جلوگیری از ثبت تکراری پس از اتصال مجدد
  clientId String? @unique

  // اطلاعیه مدیر مدرسه
  isAnnouncement Boolean @default(false)

  // پیام خودکار «ثبت تکلیف» — پیوند به تکلیف مربوطه
  assignmentId String?

  // پیام دعوت خودکار «کلاس آنلاین» — پیوند به جلسه مربوطه
  liveSessionId String?

  // پیام خودکار «نمونه‌سؤال» — پیوند به نمونه‌سؤال مربوطه
  sampleQuestionId String?

  // هدایت پیام از گفتگوی دیگر — نام فرستنده اصلی برای نمایش
  isForwarded       Boolean @default(false)
  forwardedFromName String?

  // سنجاق کردن پیام — فقط معلم منتسب یا مدیر مدرسه
  pinnedAt   DateTime?
  pinnedById String?
  pinnedBy   User?     @relation("msgPinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)

  editedAt  DateTime?
  deletedAt DateTime?
  // وضعیت خواندن در گفتگوی خصوصی (زمان خواندن توسط گیرنده)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([subjectGroupId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([assignmentId])
  @@index([liveSessionId])
  @@index([sampleQuestionId])
  @@index([subjectGroupId, pinnedAt])
}

// ─── کلاس آنلاین صوتی و تصویری (مرحله ۵) ───

// جلسه زنده — همیشه متعلق به یک کلاس مشخص است (به گروه درسی وابسته نیست)
// notifyGroup فقط برای اطلاع‌رسانی (پیام دعوت خودکار در آن گروه منتشر می‌شود)
model LiveSession {
  id            String        @id @default(cuid())
  classroomId   String
  classroom     Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  hostId        String
  host          User          @relation("liveSessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  notifyGroupId String?
  notifyGroup   SubjectGroup? @relation("liveSessionNotify", fields: [notifyGroupId], references: [id], onDelete: SetNull)
  title         String
  // ACTIVE (فعال) | ENDED (پایان‌یافته)
  status        String        @default("ACTIVE")
  startedAt     DateTime      @default(now())
  // زمان اعلام رسمی شروع کلاس — فقط یک‌بار و فقط پس از آماده‌شدن استریم معلم ثبت می‌شود؛
  // null یعنی جلسه فعال است ولی هنوز اعلان شروع برای دانش‌آموزان ارسال نشده
  announcedAt   DateTime?
  endedAt       DateTime?
  enderId       String?
  ender         User?         @relation("liveSessionEnder", fields: [enderId], references: [id], onDelete: SetNull)
  // دلیل پایان اجباری توسط مدیر کل (گزارش مدیریتی) — null یعنی پایان عادی/معلم/سیستم
  forceEndReason String?

  chatMessages    LiveChatMessage[]
  participantLogs LiveParticipantLog[]

  @@index([classroomId, status])
}

// تنظیمات سراسری رسانه‌ها (رکورد یکتا) — سیاست فرمت/حجم آپلود کل پلتفرم
model MediaSetting {
  id        String   @id @default("global")
  // JSON آرایه فرمت‌ها: [{ format, enabled, maxMB, extensions[] }]
  formats   String
  updatedAt DateTime @updatedAt
}

// گفتگوی متنی داخل جلسه — فقط برای اعضای مجاز همان جلسه (جدا از گفتگوی عمومی گروه)
model LiveChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation("liveChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// گزارش حضور در جلسه (چه کسی چه زمانی وارد/خارج شد؛ اخراج هم ثبت می‌شود)
model LiveParticipantLog {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("liveParticipantLog", fields: [userId], references: [id], onDelete: Cascade)
  role      String
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  kicked    Boolean     @default(false)
  // شمارش اتصال‌های مجدد این شرکت‌کننده در همین جلسه (قطع‌ووصل واقعی سوکت؛
  // خروج داوطلبانه و ورود دوباره بعد از آن جزو این عدد نیست)
  reconnects Int        @default(0)

  @@index([sessionId, userId])
}

// ─── تکالیف آموزشی (مرحله ۴) ───

// تکلیف — همیشه متعلق به یک گروه درسی مشخص است، هرگز فقط به کل کلاس وصل نمی‌شود
model Assignment {
  id             String       @id @default(cuid())
  subjectGroupId String
  subjectGroup   SubjectGroup @relation(fields: [subjectGroupId], references: [id], onDelete: Cascade)
  title          String
  description    String       @default("")
  // نحوه ارسال پاسخ: TEXT (متن) | FILE (فایل) | BOTH (هر دو)
  answerMode     String       @default("BOTH")
  // امکان اصلاح پاسخ توسط دانش‌آموز پس از ارسال
  allowEdit      Boolean      @default(true)
  // نمره بیشینه اختیاری؛ در صورت تعیین، نمره بین ۰ تا این عدد اعتبارسنجی می‌شود
  maxGrade       Int?
  // مهلت ارسال؛ اختیاری — پاسخ پس از آن «دیرهنگام» ثبت می‌شود
  dueAt          DateTime?
  attachmentName String?
  attachmentKey  String?
  attachmentMime String?
  attachmentSize Int?
  createdById    String
  createdBy      User         @relation("assignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  submissions    AssignmentSubmission[]
  calendarEvents ClassEvent[]

  @@index([subjectGroupId, createdAt])
}

// پاسخ دانش‌آموز به تکلیف — هر دانش‌آموز فقط پاسخ و نمره خودش را می‌بیند
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("submissionStudent", fields: [studentId], references: [id], onDelete: Cascade)

  text     String  @default("")
  fileName String?
  fileKey  String?
  fileMime String?
  fileSize Int?

  // زمان اولین ارسال ثابت می‌ماند؛ ویرایش‌ها فقط editedAt را به‌روز می‌کنند
  submittedAt DateTime  @default(now())
  editedAt    DateTime?

  // بازخورد معلم: UNSEEN (مشاهده نشده) | APPROVED (تایید شده) | REJECTED (تایید نشده) | INCOMPLETE (ناقص)
  feedbackStatus String    @default("UNSEEN")
  feedbackNote   String?
  grade          Int?
  reviewedAt     DateTime?

  @@unique([assignmentId, studentId])
}

// اعلان درون‌برنامه‌ای (تکلیف جدید، ثبت بازخورد و ...)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ASSIGNMENT_NEW | FEEDBACK_POSTED | LIVE_SESSION_NEW | PRIVATE_MESSAGE | GROUP_MESSAGE | SCHOOL_ANNOUNCEMENT
  title     String
  body      String    @default("")
  link      String?
  // کلید ضدتکرار: هر رویداد فقط یک‌بار برای هر کاربر (یکتا با userId)
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  pushDeliveries PushDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

// ─── ورود پیامکی و اعلان‌ها (مرحله ۷) ───

// ترجیحات اعلان هر کاربر
model NotificationPref {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // اعلان مرورگر (فقط با رضایت کاربر فعال می‌شود — سمت کلاینت هم بررسی می‌شود)
  browserEnabled Boolean  @default(false)
  // نمایش پیش‌نمایش متن پیام در اعلان مرورگر (پیش‌فرض خاموش برای حفظ حریم خصوصی)
  previewEnabled Boolean  @default(false)
  // انواع رویداد دارای پوش (JSON آرایه) — پیش‌فرض همه انواع
  pushEventTypes String   @default("[]")
  // صدای هشدار پاپ‌آپ شروع کلاس آنلاین — نمایش پاپ‌آپ به این تنظیم وابسته نیست
  soundEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

// گفتگوی بی‌صدا شده (گروه یا خصوصی) — بدون اعلان برای پیام‌های جدید
model MutedChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatType  String // GROUP | DIRECT
  chatKey   String // شناسه گروه درسی یا شناسه طرف مقابل
  createdAt DateTime @default(now())

  @@unique([userId, chatType, chatKey])
  @@index([userId])
}

// کد یک‌بارمصرف ورود — همیشه هش‌شده ذخیره می‌شود، هرگز خام
model OtpCode {
  id         String    @id @default(cuid())
  // HMAC-SHA256 شماره نرمال‌شده با کلید سرور — خود شماره ذخیره نمی‌شود
  phoneHmac  String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phoneHmac, createdAt])
}

// پیکربندی ورود و سرویس پیامک — تک‌ردیفی، فقط مدیر کل
model SmsConfig {
  id                    Int      @id @default(1)
  // روش‌های ورود کاربران عادی (مدیر کل همیشه با رمز وارد می‌شود)
  passwordLoginEnabled  Boolean  @default(true)
  smsLoginEnabled       Boolean  @default(false)
  // ارائه‌دهنده پیامک: "" | smsir | melipayamak | farazsms | otpy (REST سازگار)
  provider              String   @default("")
  enabled               Boolean  @default(false)
  // اعتبارهای سرویس — JSON و فقط سمت سرور (هرگز به مرورگر نمی‌رود)
  credentials           String   @default("{}")
  // سیاست کد یک‌بارمصرف
  codeTtlSeconds        Int      @default(120)
  resendCooldownSeconds Int      @default(60)
  maxAttemptsPerCode    Int      @default(5)
  maxRequestsPerHour    Int      @default(5)
  updatedAt             DateTime @updatedAt
}

// گزارش ارسال پیامک — بدون کد ورود و بدون شماره کامل (فقط ماسک‌شده)
model SmsSendLog {
  id          Int      @id @default(autoincrement())
  provider    String
  maskedPhone String
  purpose     String   @default("OTP") // OTP | TEST
  ok          Boolean
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─── دستیار هوش مصنوعی «دستیار دانیار» (مرحله ۶) ───

// تنظیمات سراسری سرویس هوش مصنوعی — فقط مدیر کل؛ کلید API هرگز به مرورگر نمی‌رود
model AiConfig {
  id                 Int      @id @default(1)
  // ارائه‌دهنده: openai | anthropic
  provider           String   @default("openai")
  // آدرس پایه سفارشی (سازگار با OpenAI/Anthropic)؛ خالی = آدرس رسمی سرویس
  baseUrl            String   @default("")
  model              String   @default("")
  // کلید API — فقط سمت سرور نگهداری می‌شود
  apiKey             String   @default("")
  enabled            Boolean  @default(false)
  // دستورالعمل عمومی دستیار + دستورالعمل نقش مدیر مدرسه
  generalInstruction String   @default("")
  managerInstruction String   @default("")
  // بیشینه فراخوانی ابزار در هر پاسخ (کنترل هزینه)
  maxToolCalls       Int      @default(4)
  updatedAt          DateTime @updatedAt
}

// تنظیمات دستیار برای هر مدرسه: فعال/غیرفعال + نقش‌ها + سهمیه مصرف
model AiSchoolSetting {
  id                Int     @id @default(autoincrement())
  schoolId          String  @unique
  school            School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // کلید اصلی مدرسه
  enabled           Boolean @default(false)
  // فعال برای نقش مدیر مدرسه (فعلاً تنها نقش دارای دستیار)
  managerEnabled    Boolean @default(true)
  // سهمیه پیام روزانه به ازای هر کاربر؛ null = بدون محدودیت
  dailyMessageLimit Int?
}

// گفتگوی خصوصی کاربر با دستیار — دائمی و فقط برای خودش
model AiConversation {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("دستیار دانیار")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId, updatedAt])
}

// پیام دستیار: USER (کاربر) | ASSISTANT (پاسخ مدل)
// refs = منابع داده برنامه که در پاسخ استفاده شد (تکلیف/کلاس/بازخورد)
model AiMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  refs           Json?
  stopped        Boolean        @default(false)
  // شناسه سمت کلاینت برای جلوگیری از ثبت تکراری
  clientId       String?        @unique
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ─── حضور و غیاب تقویم‌محور (مرحله ۸) ───

// جلسه حضور و غیاب — متعلق به یک کلاس و یک روز مشخص (تقویم جلالی)
// و یک جلسه مشخص؛ به گروه درسی وابسته نیست
model AttendanceSession {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // کلید تاریخ جلالی با قالب 1404-07-19 (مرتب‌سازی رشته‌ای صحیح و سازگار با تقویم ایرانی)
  dateKey     String
  // عنوان جلسه (مثلا «جلسه اول») — برای هر کلاس در هر روز یکتا
  title       String
  // ثبت‌کننده اولیه (معلم یا مدیر)
  creatorId   String
  creator     User      @relation("attendanceSessionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  // DRAFT (پیش‌نویس) | FINALIZED (نهایی) — جلسه پیش‌نویس در آمار نهایی دانش‌آموز حساب نمی‌شود
  status      String    @default("DRAFT")
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  records AttendanceRecord[]
  edits   AttendanceEditLog[]
  // تخلفات ثبت‌شده از داخل ویرایشگر همین جلسه
  violations StudentViolation[]
  // نمرات ثبت‌شده از داخل ویرایشگر همین جلسه (ستون «نمره» معلم)
  grades    StudentGrade[]

  @@unique([classroomId, dateKey, title])
  @@index([classroomId, dateKey])
  @@index([status])
}

// وضعیت حضور هر دانش‌آموز در جلسه — PRESENT (حاضر) | ABSENT (غایب)
// دانش‌آموز ثبت‌نام‌شده بدون رکورد در جلسه = UNSET (ثبت‌نشده؛ جدا از غیبت)
model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("attendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status    String            @default("PRESENT")
  note      String?
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

// تاریخچه اصلاحات — هر تغییر وضعیت/یادداشت با ثبت‌کننده و زمان حفظ می‌شود
model AttendanceEditLog {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  oldStatus String
  newStatus String
  oldNote   String?
  newNote   String?
  editorId  String
  editor    User              @relation("attendanceEditor", fields: [editorId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())

  @@index([sessionId, studentId])
}

// ─── ثبت تخلفات (درخواست کاربر — ادغام در حضور و غیاب روز) ───
// تخلف دانش‌آموز در تاریخ مشخص — ثبت توسط مدیر مدرسه/معاون/معلمِ همان کلاس.
// dateKey کلید جلالی (۱۴۰۴-۰۷-۱۹) است تا با تقویم و جلسات حضور و غیاب هم‌راستا باشد.
model StudentViolation {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation("violationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // کلید جلالی روز تخلف — مرتب‌سازی رشته‌ای صحیح
  dateKey     String
  // جلسه حضور و غیاب مرتبط (اگر از ویرایشگر جلسه ثبت شده باشد) — اختیاری
  sessionId   String?
  session     AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // متن تخلف (مثلاً «بی‌ادبی با معلم»)
  text        String
  creatorId   String
  creator     User      @relation("violationCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentId, dateKey])
  @@index([classroomId, dateKey])
  @@index([sessionId])
}

// ─── درس‌های مدرسه (درخواست کاربر — باکس «درس‌ها» در پنل مدیریت مدرسه) ───
// درس مدرسه‌محور است (مثل ریاضی، علوم، فارسی) و مستقل از کلاس؛
// با فرم لیستی چند درس هم‌زمان ساخته می‌شود و از طریق فرم ایجاد معلم به معلمان منتسب می‌شود.
model Lesson {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherLessons TeacherLesson[]
  // نمراتی که با این درس ثبت شده‌اند — حذف درس، درسِ نمرات را خالی می‌کند (نمرات می‌مانند)
  grades         StudentGrade[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// ─── انتساب درس به معلم (درخواست کاربر — فیلد چندانتخابی فرم ایجاد معلم) ───
// هر معلم می‌تواند یک یا چند درس داشته باشد؛ مبنا dropdown «درس» در ثبت نمره است.
model TeacherLesson {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("teacherLessonTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, lessonId])
  @@index([lessonId])
}

// ─── نمرهٔ دانش‌آموز (درخواست کاربر — ستون «نمره» در ثبت حضور و غیاب معلم) ───
// معلم در روز انتخابی برای هر دانش‌آموز نمره ثبت می‌کند؛
// عنوان نمره (مثلاً «آزمون مهر ماه») و درس مربوط با کل فرم ارسال می‌شوند.
// در صورت ثبت حداقل یک نمره، عنوان نمره اجباری می‌شود (اعتبارسنجی سرور و کلاینت).
model StudentGrade {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation("gradeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // کلید جلالی روز نمره — هم‌راستا با جلسات حضور و غیاب
  dateKey     String
  // جلسهٔ حضور و غیاب مرتبط (اگر از ویرایشگر جلسه ثبت شده باشد) — اختیاری
  sessionId   String?
  session     AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // عنوان نمره (اجباری در صورت ثبت نمره)
  title       String
  // درس مرتبط — اختیاری؛ فقط از درس‌های منتسب به معلم
  lessonId    String?
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  // خود نمره — رشتهٔ کوتاه (عددی یا توصیفی مثل «خیلی خوب»)
  score       String
  creatorId   String
  creator     User      @relation("gradeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentId, dateKey])
  @@index([classroomId, dateKey])
  @@index([sessionId])
}

// ─── محدودیت دسترسی‌های معاون مدرسه (درخواست کاربر) ───
// معاون به‌طور پیش‌فرض «همهٔ» دسترسی‌های مدیر مدرسه را دارد؛
// هر ردیف یک مجوز است که مدیر مدرسه می‌تواند جداگانه خاموش/روشن کند.
// نبودِ ردیف = مجوز فعال (پیش‌فرض روشن). فقط کاربران نقش SCHOOL_VICE ردیف دارند.
model VicePermission {
  id        String   @id @default(cuid())
  viceId    String
  vice      User     @relation("vicePermissionVice", fields: [viceId], references: [id], onDelete: Cascade)
  // کلید مجوز از VICE_PERMISSIONS (src/lib/vice-permissions.ts)
  key       String
  // false = محدود شده توسط مدیر مدرسه
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([viceId, key])
}

// آمار مصرف و خطا — بدون هیچ متن گفتگو؛ فقط مدیر کل می‌بیند
model AiUsageLog {
  id           Int      @id @default(autoincrement())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId     String?
  ok           Boolean
  errorType    String? // CONFIG_MISSING | DISABLED_GLOBAL | DISABLED_SCHOOL | QUOTA | PROVIDER_ERROR | TIMEOUT | ABORTED
  provider     String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  createdAt    DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
}

// ─── کتابخانه نمونه‌سؤالات (مرحله ۹) ───

// نمونه‌سؤال — متعلق به کلاس‌های انتخاب‌شده معلم (چندکلاسه) و مستقل از گروه درسی
// نام درس برای دسته‌بندی و جست‌وجو ثبت می‌شود
model SampleQuestion {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  // نام درس (دسته‌بندی و جست‌وجو)
  subject     String
  // موضوع (اختیاری) برای جست‌وجوی دقیق‌تر
  topic       String?
  description String    @default("")
  // نمایش پاسخ‌نامه برای دانش‌آموزان (پیش‌فرض غیرفعال)
  showAnswer  Boolean   @default(false)
  // PUBLISHED (منتشرشده) | UNPUBLISHED (پیش‌نویس) — دانش‌آموز فقط منتشرشده را می‌بیند
  status      String    @default("PUBLISHED")
  publishedAt DateTime?
  createdById String
  createdBy   User      @relation("sampleqCreator", fields: [createdById], references: [id], onDelete: Cascade)
  // شناسه سمت کلاینت — تلاش مجدد هرگز نمونه‌سؤال تکراری نمی‌سازد
  clientId    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classes   SampleQuestionClass[]
  files     SampleQuestionFile[]
  bookmarks SampleQuestionBookmark[]

  @@index([schoolId, status, createdAt])
  @@index([schoolId, subject])
  @@index([createdById])
}

// کلاس‌های مخاطب نمونه‌سؤال (انتخاب چند کلاس توسط معلم)
model SampleQuestionClass {
  id          String         @id @default(cuid())
  questionId  String
  question    SampleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([questionId, classroomId])
  @@index([classroomId])
}

// فایل نمونه‌سؤال یا پاسخ‌نامه — هر فایل کلید ذخیره‌سازی یکتای خودش را دارد؛
// حذف/جایگزینی فایل یک نمونه‌سؤال هرگز فایل نمونه‌سؤال دیگر را حذف نمی‌کند
model SampleQuestionFile {
  id         String         @id @default(cuid())
  questionId String
  question   SampleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // QUESTION (فایل سؤال) | ANSWER (فایل پاسخ‌نامه)
  role       String
  name       String
  key        String         @unique
  mime       String
  size       Int
  createdAt  DateTime       @default(now())

  @@index([questionId, role])
}

// نشان‌گذاری نمونه‌سؤال برای دسترسی سریع (توسط دانش‌آموز)
model SampleQuestionBookmark {
  id         String         @id @default(cuid())
  questionId String
  question   SampleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation("sampleqBookmarker", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([questionId, userId])
  @@index([userId])
}

// ─── تقویم آموزشی کلاسی ───

// رویداد تقویم آموزشی — کاملاً کلاس‌محور؛ هر کلاس تقویم جداگانه خودش را دارد.
// classroomId = null یعنی رویداد «کل مدرسه» (فقط مدیر مدرسه) که در تقویم
// همه کلاس‌های آن مدرسه هم نمایش داده می‌شود.
// تاریخ با کلید جلالی «1404-07-19» ذخیره می‌شود (سازگار با حضور و غیاب).
model ClassEvent {
  id          String     @id @default(cuid())
  schoolId    String
  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // کلید تاریخ جلالی با قالب 1404-07-19 (مرتب‌سازی رشته‌ای صحیح)
  dateKey     String
  // HOLIDAY | EXAM | HOMEWORK | PARTY | SPORTS | ACADEMIC | TRIP | CUSTOM
  type        String
  // نام رویداد سفارشی — فقط برای نوع CUSTOM
  customTitle String?
  description String     @default("")
  createdById String
  createdBy   User       @relation("classEventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // تکلیف درسی مرتبط — فقط برای نوع HOMEWORK که از تقویم همراه با ایجاد تکلیف ثبت می‌شود؛
  // حذف تکلیف → رویداد تقویم باقی می‌ماند (SetNull) و لینک نمایش داده نمی‌شود
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([schoolId, dateKey])
  @@index([classroomId, dateKey])
  @@index([createdById])
  @@index([assignmentId])
}

// ─── پوش نوتیفیکیشن واقعی مرورگر (Web Push + Service Worker) ───

// اشتراک پوش هر دستگاه مرورگر — endpoint یکتاست؛ endpoint و کلیدهای
// رمزنگاری هرگز به هیچ کلاینتی برگردانده نمی‌شوند (فقط سمت سرور)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // آدرس یکتای سرویس پوش مرورگر (FCM/Mozilla/…)
  endpoint  String   @unique
  p256dh    String
  auth      String
  // شناسه دستگاه سمت کلاینت — برای مدیریت «همین دستگاه»
  deviceId  String?
  // برچسب کوتاه دستگاه (نام مرورگر / سیستم‌عامل) — بدون رشته کامل UA
  label     String?
  // خاموش/روشن پوش فقط برای همین دستگاه
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries PushDelivery[]

  @@index([userId])
  @@index([deviceId])
}

// یک ارسال پوش به یک اشتراک برای یک اعلان مشخص — ضدتکرار قطعی:
// هر اشتراک هر رویداد را حداکثر یک‌بار دریافت می‌کند
model PushDelivery {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  // نوع رویداد برای گزارش مدیر کل (بدون هیچ محتوای خصوصی)
  type           String
  // PENDING | SENT | FAILED | EXPIRED | SKIPPED
  status         String           @default("PENDING")
  attempts       Int              @default(0)
  // فقط خطای غیرمحرمانه (کد وضعیت/دسته خطا) — هرگز endpoint/کلید/متن پیام
  lastError      String?
  nextAttemptAt  DateTime?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?

  @@unique([subscriptionId, notificationId])
  @@index([status, nextAttemptAt])
  @@index([type, status, createdAt])
}

// پیکربندی پوش پلتفرم — تک‌ردیفی؛ کلیدهای VAPID فقط در env سرور (نه دیتابیس)
model PushConfig {
  id              Int      @id @default(1)
  platformEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// گزارش جعل هویت (ورود مدیر کل به‌جای کاربر) — برای حسابرسی
model ImpersonationLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     User      @relation("impersonationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  targetId  String
  target    User      @relation("impersonationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([adminId, startedAt])
}

// گزارش ارسال انبوه پیامک/اعلان مدیر کل — متن پیام اطلاع‌رسانی عمومی مدیر است
model BulkSendLog {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("bulkSendLog", fields: [senderId], references: [id], onDelete: Cascade)
  channel     String // SMS | PUSH
  schoolId    String?
  classroomId String?
  roles       String   @default("[]") // JSON آرایه نقش‌ها
  text        String   @default("")
  total       Int      @default(0)
  sent        Int      @default(0)
  failed      Int      @default(0)
  skipped     Int      @default(0)
  ok          Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// تنظیمات سراسری پلتفرم (رکورد یکتا با id='global') — هویت، فونت، پس‌زمینه چت و اسپلش
model PlatformSetting {
  id                     String   @id @default("global")
  // ─── هویت ───
  appName                String   @default("دانیار")
  logoKey                String?
  // ─── فونت برنامه ───
  fontPreset             String   @default("vazirmatn")
  fontCustomKey          String?
  // ─── پس‌زمینه چت موبایل (جداگانه برای حالت روشن/تیره) ───
  chatBgKey              String?
  chatBgDarkKey          String?
  // ─── اسپلش اسکرین ───
  splashEnabled          Boolean  @default(true)
  splashDurationMs       Int      @default(2200)
  splashShowAppName      Boolean  @default(true)
  splashShowDisplayName  Boolean  @default(true)
  splashBgKey            String?
  splashAppNameFont      String   @default("")
  splashAppNameColor     String   @default("#0f766e")
  splashAppNameSize      Int      @default(56)
  splashDisplayNameFont  String   @default("")
  splashDisplayNameColor String   @default("#475569")
  splashDisplayNameSize  Int      @default(16)
  updatedAt              DateTime @updatedAt
}

// ─── پایش زیرساخت (پنل مدیر کل: /superadmin/infrastructure) ───
// آستانه‌های هشدار منابع — رکورد یکتا با id='global'؛ فقط عدد درصد (۱..۹۹)
model InfraSetting {
  id              String   @id @default("global")
  cpuThreshold    Int      @default(85)
  ramThreshold    Int      @default(85)
  diskThreshold   Int      @default(90)
  // تعداد نمونهٔ متوالی بالای آستانه برای «هشدار پایدار» (جلوگیری از هشدار لحظه‌ای)
  sustainedCount  Int      @default(3)
  updatedAt       DateTime @default(now()) @updatedAt
}

// رویدادهای پایش: خطای سرویس، هشدار پایدار منابع و بازیابی — فقط تغییر وضعیت
// ثبت می‌شود (نه هر poll) و سیاست پاک‌سازی دارد تا دیتابیس رشد نامحدود نداشته باشد.
model InfraEventLog {
  id        String   @id @default(uuid())
  kind      String   // 'error' | 'alert' | 'recovery'
  service   String   // 'db' | 'upload' | 'socket' | 'livekit' | 'turn' | 'cpu' | 'ram' | 'disk'
  message   String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// انواع تخلف (درخواست کاربر) — فهرست کشویی چندانتخابی ثبت تخلف در ویرایشگر جلسه؛
// مدیر کل از پنل خود گزینه‌ها را مدیریت می‌کند (افزودن/غیرفعال‌کردن/حذف).
// تخلف‌های ثبت‌شدهٔ قبلی متن آزاد خود را حفظ می‌کنند (سابقه دست‌نخورده).
model ViolationType {
  id        String   @id @default(cuid())
  // برچسب تخلف (مثلاً «انجام ندادن تکلیف») — یکتا
  label     String   @unique
  // غیرفعال: در فهرست انتخاب معلم/مدیر نمایش داده نمی‌شود اما سابقه حفظ می‌شود
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
