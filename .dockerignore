# ---- Data (lives on volumes, not in the image) ----
# The SQLite DB is created/imported on the db_data volume at runtime;
# uploaded files live on the uploads_data volume
# (docker-entrypoint.sh symlinks public/uploads → /data/uploads).
db
data
public/uploads
