# ─── مصنوعات build/اجرای محلی — هرگز در گیت نیستند (ریپو سبک می‌ماند) ───
# بستهٔ استقرار با scripts/rebuild-deploy-archive.sh از فایل‌های tracked ساخته می‌شود؛
# استقرار داکر socket-server.mjs را داخل ایمیج از سورس می‌سازد (Dockerfile) و
# دیتابیس VPS با migrations+seed ساخته می‌شود — هیچ‌کدام لازم نیستند tracked باشند.
/download/
/upload/
/tool-results/
/socket-server.mjs
/.tools/livekit-server
/.tools/bin/
/db/*.db
/prisma/dev.db
/tmp-archive-*
# رسانه‌های runtime آپلود کاربران (فقط .gitkeep نگه داشته می‌شود)
/uploads/*
!/uploads/.gitkeep

# Local preview credentials and generated delivery archives
!.env.example
/.tools/turnserver
/.tools/turnserver-preview.conf
/public/*repo*.tar.gz
*.db-wal
*.db-shm
