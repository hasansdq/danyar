# ─────────────────────────────────────────────────────────────────────────────
# الگوی .env دانیار — این فایل را به .env کپی کنید و مقادیر امن بسازید:
#   cp .env.example .env
# بدون مقادیر «الزامی» استقرار عمداً بالا نمی‌آید (docker-compose خودش گارد دارد)
# ─────────────────────────────────────────────────────────────────────────────

# ─── الزامی ──────────────────────────────────────────────────────────────────
# رمز امضای سشن کوکی‌ها (ساخت: openssl rand -base64 32)
SESSION_SECRET=
# رمز ارتباط داخلی Next.js ↔ سرویس Socket (ساخت: openssl rand -base64 24)
SOCKET_INTERNAL_SECRET=

# ⚠ DATABASE_URL در سرور تنظیم نکنید — docker-compose خودش
#   file:/data/daniar.db روی ولوم پایدار را ست می‌کند.
# (فقط برای اجرای محلی خارج از docker: DATABASE_URL=file:/path/to/db/custom.db)

# ─── پروفایل‌ها ──────────────────────────────────────────────────────────────
# media = LiveKit روی همین سرور (کلاس آنلاین) | turn = coturn برای شبکه‌های سختگیر
# برای سرور رسانه جدا: مقدار را خالی بگذارید و NEXT_PUBLIC_LIVEKIT_WS_URL را ست کنید
COMPOSE_PROFILES=media
# COMPOSE_PROFILES=media,turn

# ─── کلاس آنلاین (LiveKit SFU) — الزامی با پروفایل media ────────────────────
# ساخت هر دو: openssl rand -hex 16  (باید KEY:SECRET یکسان در سرویس رسانه باشد)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# آدرس مدیریتی LiveKit از سمت سرویس‌های web/socket (پیش‌فرض: شبکه داخلی docker)
LIVEKIT_INTERNAL_URL=http://livekit:7880
# IP عمومی VPS — الزامی با پروفایل media (بدون آن کاندیدهای ICE به STUN خارجی تکیه می‌کنند)
LIVEKIT_NODE_IP=
# سقف شرکت‌کننده هر جلسه (پیش‌فرض ۳۲؛ ظرفیت اختصاصی هر کلاس و سقف اختصاصی هر مدرسه
# از پنل «مدیریت کلاس‌های آنلاین» جدا می‌شود — ظرفیت مؤثر = حداقلِ این‌ها)
LIVE_MAX_PARTICIPANTS=32
# سقف جهانی جلسات هم‌زمان هر مدرسه (اختیاری؛ خالی/۰ = نامحدود. سقف اختصاصی هر
# مدرسه از پنل «مدیریت کلاس‌های آنلاین» تعیین می‌شود و همین مقدار را override می‌کند)
LIVE_MAX_CONCURRENT_SESSIONS=

# ─── سرور رسانه جدا / LiveKit Cloud (اختیاری) ───────────────────────────────
# وقتی ست شود، رسانهٔ کلاس آنلاین از این سرویس بیرونی می‌گذرد (نه LiveKit محلی):
#   - مرورگرها برای سیگنال/رسانه به همین آدرس وصل می‌شوند (wss، قابل دسترس از اینترنت)
#   - مدیریت (توکن/مجوز/اخراج/پایان) از بک‌اند با LIVEKIT_INTERNAL_URL + همان KEY/SECRET
# مثال LiveKit Cloud (پروژهٔ ابری — کلیدها را از کنسول LiveKit بردارید):
#   NEXT_PUBLIC_LIVEKIT_WS_URL=wss://<project>.livekit.cloud
#   LIVEKIT_INTERNAL_URL=wss://<project>.livekit.cloud   (یا https://… — اسکیم wss
#     خودکار برای فراخوانی‌های مدیریتی Twirp به https نرمال می‌شود)
#   LIVEKIT_API_KEY=API-xxxx        (فقط سمت سرور — هرگز در NEXT_PUBLIC/API/لاگ نگذارید)
#   LIVEKIT_API_SECRET=xxxxxxxxxxxx
# در این حالت: پروفایل media خاموش می‌شود (COMPOSE_PROFILES= خالی) و خودترمیم/
# نگهبان، LiveKit محلی را مدیریت نمی‌کنند؛ STUN/TURN کامل از خود سرویس بیرونی
# می‌آید (در پاسخ join) مگر آنکه LIVE_TURN_URLS صریحاً ست کرده باشید.
# ⚠ مهم: با LiveKit Cloud متغیرهای TURN (LIVE_TURN_* و LIVEKIT_PUBLIC_TURN_*)
# را خالی/حذف بگذارید — مقدار کهنه TURN خود Cloud را کنار می‌زند و مسیر رسانه
# را به رلهٔ قدیمی می‌بَرَد؛ iceServers خالی = TURN/TLS خود Cloud.
# برای سرور رسانه جدا با دامنه اختصاصی هم همین الگو:
#   NEXT_PUBLIC_LIVEKIT_WS_URL=wss://live.example.com
#   LIVEKIT_INTERNAL_URL=https://live.example.com  (یا http://IP:7880 از داخل شبکه)
NEXT_PUBLIC_LIVEKIT_WS_URL=

# ─── پل رسانهٔ عمومی برای «پیش‌نمایش dev» سندباکس (اختیاری — فقط توسعه) ──────
# مشکل پیش‌نمایش: درگاه فقط HTTP/WS عبور می‌دهد و UDP/TCP رسانه از سندباکس
# بیرون نمی‌رود → کاندید ICE مرورگر بیرونی هیچ‌وقت به LiveKit محلی نمی‌رسد.
# راه‌حل dev: coturn محلی (:3478) که از طریق تونل TCP به یک رلهٔ عمومی
# در دسترس عمومی است؛ مرورگر بیرونیِ پیش‌نمایش با TURN/TCP (پشتیبانی‌شده در
# همهٔ مرورگرها) از مسیر عمومی رسانه می‌گیرد. dev-up/watchdog هر دو را زنده
# نگه می‌دارند. برای sandbox: باینری coturn در .tools/turnserver و کانفیگ
# .tools/turnserver-preview.conf (تولیدشده با اعتبارنامهٔ همین .env).
# ⚠ این پل فقط برای حالت «LiveKit محلی» معنا دارد؛ با LiveKit Cloud این‌ها
# باید خالی/کامنت بمانند (TURN خود Cloud اعمال می‌شود) و dev-up/watchdog هم
# در حالت رسانهٔ بیرونی، coturn/تونل را مدیریت نمی‌کنند.
#   LIVEKIT_PUBLIC_TURN_HOST=<relay-host>     ← میزبان رلهٔ عمومی
#   LIVEKIT_PUBLIC_TURN_PORT=3478             ← پورت عمومی رله
#   LIVE_TURN_URLS=turn:<relay-public-ip>:3478?transport=tcp
#   LIVE_TURN_USERNAME=... / LIVE_TURN_CREDENTIAL=...   (هم‌مقدار coturn)
# در تولید این‌ها را خالی بگذارید و از پروفایل turn خود docker-compose
# استفاده کنید (coturn روی VPS با IP عمومی — بخش ICE/TURN پایین).
LIVEKIT_PUBLIC_TURN_HOST=
LIVEKIT_PUBLIC_TURN_PORT=3478

# ─── ICE/TURN ────────────────────────────────────────────────────────────────
LIVE_STUN_URLS=stun:stun.l.google.com:19302
# با پروفایل turn این سه‌تا را بسازید (openssl rand -hex 16 برای credential)
LIVE_TURN_URLS=
LIVE_TURN_USERNAME=
LIVE_TURN_CREDENTIAL=
TURN_EXTERNAL_IP=
TURN_REALM=daniar
# TLS اختیاری TURN: گواهی/کلید را در deploy/coturn/ بگذارید
# TURN_CERT_FILE=/etc/coturn/cert.pem
# TURN_KEY_FILE=/etc/coturn/key.pem

# ─── پوش مرورگر (Web Push/VAPID) ────────────────────────────────────────────
# بدون این‌ها پوش 503 می‌دهد (تولید: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# صف پوش (پیش‌فرض تولید: TTL ۱۵ دقیقه، ۳ تلاش، پایه ۴۵ ثانیه)
PUSH_TTL_MINUTES=15
PUSH_MAX_ATTEMPTS=3
PUSH_RETRY_BASE_SECONDS=45

# ─── دستیار هوش مصنوعی (اختیاری) ────────────────────────────────────────────
# ارائه‌دهنده/کلید از پنل مدیر کل تنظیم می‌شود؛ فقط مهلت اینجاست
AI_TIMEOUT_MS=120000

# ─── مدیر کل اولیه ──────────────────────────────────────────────────────────
# رمز superadmin که اولین بار ساخته می‌شود (بعد از اولین ورود عوضش کنید)
SUPERADMIN_INITIAL_PASSWORD=

# ─── پایش زیرساخت (پنل مدیر کل: /superadmin/infrastructure) ────────────────
# حالت اجرا فقط «نمایش» داده می‌شود (از پنل قابل تغییر نیست). تشخیص خودکار:
#   سندباکس/پیش‌نمایش Z.AI از نشانگرهای FC_*، Docker از /.dockerenv/cgroup،
#   توسعه از NODE_ENV — و اگر چیزی قطعی نبود «نامشخص» نشان داده می‌شود.
# در استقرار Docker مقدار را خود docker-compose ست می‌کند (INFRA_RUN_MODE=docker).
# برای استقرار مستقیم (DirectAdmin/اجرا با node) صریح ست کنید:
#   INFRA_RUN_MODE=direct
INFRA_RUN_MODE=

# اعتماد به گواهی خودامضای شبیه‌ساز پوش (تست واقعی web-push در dev)
NODE_EXTRA_CA_CERTS=/home/z/my-project/scripts/test-certs/push-test-cert.pem
