# ============================================================
# Daniyar — Docker Production Environment (TEMPLATE)
# کپی کنید:  cp .env.example .env
# سپس مقادیر REQUIRED را پر کنید ( deploy.sh بدون آن‌ها اجرا نمی‌شود.)
# ============================================================

# ---------------- REQUIRED (اجباری — بدون این‌ها deploy متوقف می‌شود) ----------------

# آدرس عمومی برنامه (با http/https، بدون / در انتها)
# مثال‌ها:
#   NEXTAUTH_URL=http://178.62.1.2              ← آی‌پی سرور (پورت ۸۰)
#   NEXTAUTH_URL=http://178.62.1.2:8080         ← اگر HTTP_PORT=8080 گذاشته‌اید
#   NEXTAUTH_URL=https://daniyar.example.com    ← با دامنه + HTTPS خودکار
NEXTAUTH_URL=http://localhost

# کلید امضای JWT برای نشست‌های NextAuth — بسازید با:
#   openssl rand -base64 32
# (در Production نبود/کوتاه بودن آن باعث توقف برنامه می‌شود)
NEXTAUTH_SECRET=

# کلید مشترک HMAC برای توکن‌های کوتاه‌عمر Socket.IO — بسازید با:
#   openssl rand -base64 32
# ⚠️ باید در nextjs و chat-service و classroom-service «یکسان» باشد.
# (همین یک مقدار برای هر سه سرویس در docker-compose پاس می‌شود)
SOCKET_AUTH_SECRET=

# ---------------- Initial Admin (اجباری — فقط بار اول) ----------------
# در اولین بوت، ادمین با این مشخصات ساخته می‌شود.
# ⚠️ ADMIN_PASSWORD در Production اجباری است — بدون آن deploy متوقف می‌شود.
# رمز عبور هرگز به‌صورت خودکار تولید نمی‌شود و هرگز در لاگ‌ها چاپ نمی‌شود.
# حداقل ۸ کاراکتر با حرف کوچک + بزرگ + عدد (در غیر این صورت deploy متوقف می‌شود).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# داده‌های نمونه (teacher1 / student1 / ...) فقط برای dev/staging.
# ⛔ در Production ممنوع است — SEED_DEMO_DATA=true باعث توقف deployment می‌شود.
SEED_DEMO_DATA=false

# SSL توسط DirectAdmin مدیریت می‌شود. درگاه ثابت: 127.0.0.1:3034
# NEXTAUTH_URL را برابر https://دامنه-واقعی قرار دهید.

# ---------------- Database (اختیاری — پیش‌فرض SQLite) ----------------
# پیش‌فرض: SQLite مشترک روی volume (برای یک سرورِ تک‌نفره کافی است).
# برای بار سنگین/چند instance به PostgreSQL مهاجرت کنید:
#   1) این‌ها را در .env بگذارید:
#        DB_PROVIDER=postgres
#        DATABASE_URL=postgresql://daniyar:STRONG_PASS@postgres:5432/daniyar
#        POSTGRES_PASSWORD=STRONG_PASS
#   2) اجرا:  docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
# (برای SQLite این خط‌ها را دست نزنید)
#DB_PROVIDER=postgres
#DATABASE_URL=postgresql://daniyar:daniyar@postgres:5432/daniyar
#POSTGRES_USER=daniyar
#POSTGRES_PASSWORD=
#POSTGRES_DB=daniyar

# ---------------- Socket.io origins (اختیاری) ----------------
# اتصال‌های هم‌مبدأ (از طریق gateway) همیشه مجازند.
# اگر لازم است دامنه‌های دیگری مستقیم به socket وصل شوند، اینجا بگذارید
# (با کاما جدا کنید):
#SOCKET_ALLOWED_ORIGINS=https://daniyar.example.com

# ---------------- WebRTC (اختیاری) ----------------
# برای کیفیت بهتر کلاس ویدئویی پشت NAT/فایروال
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------------- SMS OTP Providers (اختیاری) ----------------
# «مدیریت OTP» در پنل مدیر کل (/superadmin/otp) همان مقادیر را از طریق
# پنل هم می‌پذیرد (رزولوشن: مقدار پنل > متغیر محیطی). Secretها هرگز به
# فرانت‌اند برنمی‌گردند. سرویس فعال + اعتبارنامه‌ها از پنل انتخاب می‌شود.
# OTPy (otpy.ir) — سرویس OTP مدیریت‌شده:
#SMS_OTPY_API_KEY=
# ملی پیامک (rest.payamak-panel.com):
#SMS_MELIPAYAMAK_USERNAME=
#SMS_MELIPAYAMAK_PASSWORD=
#SMS_MELIPAYAMAK_FROM=
#SMS_MELIPAYAMAK_BODY_ID=
# فراز اس‌ام‌اس / IPPanel (api2.ippanel.com):
#SMS_FARAZ_API_KEY=
#SMS_FARAZ_SENDER=
#SMS_FARAZ_PATTERN_CODE=
#SMS_FARAZ_PATTERN_ARG=
# SMS.ir (api.sms.ir):
#SMS_SMSIR_API_KEY=
#SMS_SMSIR_LINE_NUMBER=
#SMS_SMSIR_TEMPLATE_ID=
#SMS_SMSIR_TEMPLATE_PARAM=

# کلید HMAC برای هش‌کردن کدهای OTP در دیتابیس (کد هرگز به‌صورت خام ذخیره
# نمی‌شود). اگر خالی باشد از NEXTAUTH_SECRET مشتق می‌شود. با:
#   openssl rand -base64 32
# (تغییر آن همه کدهای در جریان را باطل می‌کند — رفتار امنی.)
#OTP_HASH_SECRET=

# ---------------------------------------------------------------
# نکته: در محیط توسعه (بدون Docker)، مقدار NEXTAUTH_SECRET و
# SOCKET_AUTH_SECRET باید در فایل .env پروژه (و .env سرویس‌های
# mini-services) قرار بگیرد — هیچ fallback ناامنی در کد وجود ندارد و
# نبود Secret باعث توقف فوری برنامه می‌شود.

# DirectAdmin gateway is fixed at 127.0.0.1:3034; SSL belongs to DirectAdmin.
# NEXTAUTH_URL must be https://your-public-domain
# PostgreSQL: use docker compose -f docker-compose.yml -f docker-compose.postgres.yml
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
