# ============================================================
# Caddyfile — Gateway for Docker production deployment
#
# HTTP-only upstream behind DirectAdmin, which terminates TLS.
# Trusted internal proxy headers preserve the original HTTPS scheme.
#
# Security headers are set here (gateway level) AND in the app
# (src/proxy.ts) — defense in depth. CSP is owned by the app.
# ============================================================

{
	# Hardening: don't advertise server internals.
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:80 {
	# Gzip/zstd compression
	encode gzip zstd

	# --- Security headers (gateway level, covers ALL upstreams) ---
	header {
		# HSTS — only meaningful on HTTPS; browsers ignore it on plain HTTP.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
		# Don't leak the Caddy version.
		-Server
		# Keep security headers on error responses too.
		defer
	}

	# --- Body size limit (uploads max 25MB + overhead) ---
	request_body {
		max_size 30MB
	}

	# --- chat-service (XTransformPort=3003) ---
	@chat_service {
		query XTransformPort=3003
	}
	handle @chat_service {
		reverse_proxy chat-service:3003 {
			header_up Host {host}
		}
	}

	# --- classroom-service (XTransformPort=3004) ---
	@classroom_service {
		query XTransformPort=3004
	}
	handle @classroom_service {
		reverse_proxy classroom-service:3004 {
			header_up Host {host}
		}
	}

	# --- Default: forward to the Next.js app ---
	handle {
		reverse_proxy nextjs:3000 {
			header_up Host {host}
		}
	}
}
