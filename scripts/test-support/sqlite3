#!/usr/bin/env python3
"""شبیه‌ساز مینیمال CLI sqlite3 برای تست‌های بدون docker — زیرمجموعه استفاده‌شده در restore.sh/entrypoint"""
import sqlite3
import sys


def main() -> int:
    args = sys.argv[1:]
    if not args:
        print("usage: sqlite3 DB [SQL|dot-command]", file=sys.stderr)
        return 1
    db = args[0]
    stmts = args[1:] or ["SELECT 1;"]
    try:
        con = sqlite3.connect(db)
    except sqlite3.Error as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
    rc = 0
    for s in stmts:
        s = s.strip()
        if not s:
            continue
        if s.startswith("."):
            # .backup DEST
            parts = s.split()
            if parts[0] == ".backup" and len(parts) >= 2:
                try:
                    dest = sqlite3.connect(parts[1])
                    con.backup(dest)
                    dest.close()
                except sqlite3.Error as e:
                    print(f"Error: {e}", file=sys.stderr)
                    rc = 1
            else:
                print(f"Error: unsupported dot-command {parts[0]}", file=sys.stderr)
                rc = 1
            continue
        head = s.split(None, 1)[0].upper()
        try:
            if head in ("PRAGMA", "SELECT") or s.upper().startswith("WITH"):
                cur = con.execute(s)
                if cur.description is not None:
                    for row in cur.fetchall():
                        print("|".join("" if v is None else str(v) for v in row))
            else:
                con.executescript(s if s.endswith(";") else s + ";")
        except sqlite3.DatabaseError as e:
            print(f"Error: {e}", file=sys.stderr)
            rc = 1
    con.close()
    return rc


if __name__ == "__main__":
    sys.exit(main())
